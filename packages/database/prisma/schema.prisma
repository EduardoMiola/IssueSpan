generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String       @unique
  // Nullable only for the IS-14 bootstrap rows; password login fails closed without it.
  passwordHash String?      @map("password_hash")
  displayName  String?      @map("display_name")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships  Membership[]
  sessions     Session[]

  @@map("users")
}

model Organization {
  id            String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug          String            @unique
  name          String
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships   Membership[]
  accounts      CustomerAccount[]
  contacts      Contact[]
  conversations Conversation[]
  messages      Message[]
  outbox        OutboxEvent[]

  @@map("organizations")
}

model Membership {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "memberships_organization_id_fkey")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "memberships_user_id_fkey")

  @@unique([organizationId, userId])
  @@index([organizationId, role], map: "memberships_org_role_idx")
  @@map("memberships")
}

model Session {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  authMethod        String    @default("PASSWORD") @map("auth_method")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sessions_user_id_fkey")

  @@index([userId, absoluteExpiresAt], map: "sessions_user_absolute_expiry_idx")
  @@map("sessions")
}

model CustomerAccount {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_accounts_organization_id_fkey")
  contacts       Contact[]

  @@unique([organizationId, id])
  @@index([organizationId, name], map: "customer_accounts_org_name_idx")
  @@map("customer_accounts")
}

model Contact {
  id                String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  customerAccountId String          @map("customer_account_id") @db.Uuid
  name              String
  email             String?
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contacts_organization_id_fkey")
  customerAccount   CustomerAccount @relation(fields: [organizationId, customerAccountId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction, map: "contacts_organization_id_customer_account_id_fkey")

  @@unique([organizationId, id])
  @@index([organizationId, customerAccountId], map: "contacts_org_account_idx")
  @@map("contacts")
}

model Conversation {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  status         String
  lastActivityAt DateTime     @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "conversations_organization_id_fkey")
  messages       Message[]

  @@unique([organizationId, id])
  @@index([organizationId, status, lastActivityAt(sort: Desc), id(sort: Desc)], map: "conversations_inbox_idx")
  @@map("conversations")
}

model Message {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  direction      String
  content        String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "messages_organization_id_fkey")
  conversation   Conversation @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction, map: "messages_organization_id_conversation_id_fkey")

  @@unique([organizationId, id])
  @@index([organizationId, conversationId, createdAt], map: "messages_conversation_idx")
  @@map("messages")
}

model OutboxEvent {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  eventType      String       @map("event_type")
  eventVersion   Int          @default(1) @map("event_version")
  aggregateType  String       @map("aggregate_type")
  aggregateId    String       @map("aggregate_id") @db.Uuid
  payload        Json
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt    DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  attemptCount   Int          @default(0) @map("attempt_count")
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(6)
  lastError      String?      @map("last_error")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "outbox_events_organization_id_fkey")

  @@unique([organizationId, id])
  @@index([organizationId, publishedAt, availableAt], map: "outbox_available_idx")
  @@map("outbox_events")
}
