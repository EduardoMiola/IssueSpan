# Local development only. Never use these values in a deployed environment.

POSTGRES_PORT=5432
POSTGRES_DB=issuespan
POSTGRES_USER=issuespan
POSTGRES_PASSWORD=issuespan-local-only
DATABASE_URL=postgresql://issuespan:issuespan-local-only@localhost:5432/issuespan
# Local runtime-role smoke tests only; production credentials are provisioned separately.
DATABASE_APP_URL=postgresql://issuespan_app:issuespan-app-local-only@localhost:5432/issuespan
DATABASE_TEST_URL=postgresql://issuespan:issuespan-local-only@localhost:5432/issuespan

# API browser origin allowlist. Local HTTP is development-only; deployed cookies stay Secure.
TRUSTED_APP_ORIGINS=http://localhost:5173

VALKEY_PORT=6379
VALKEY_URL=redis://localhost:6379

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=issuespan-local
MINIO_ROOT_PASSWORD=issuespan-local-only
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=issuespan-local
S3_SECRET_KEY=issuespan-local-only
S3_BUCKET=issuespan-development
S3_FORCE_PATH_STYLE=true
