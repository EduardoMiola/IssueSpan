{
  "name": "issuespan",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "db:generate": "pnpm --filter @issuespan/database db:generate",
    "db:migrate": "pnpm --filter @issuespan/database db:migrate",
    "db:validate": "pnpm --filter @issuespan/database db:validate",
    "db:test": "pnpm --filter @issuespan/database db:test",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:ps": "docker compose ps",
    "infra:reset": "docker compose down -v"
  }
}
